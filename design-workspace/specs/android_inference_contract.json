        "label": "string",
        "confidence": "number"
      },
      "top_3": [
        {
          "label": "string",
          "confidence": "number"
        }
      ],
      "allow_confident_display": "boolean"
    },
    "quality_result": {
      "status": "good | noisy | too_short | clipped | unclear",
      "reason": "string"
    },
    "window_predictions": [
      {
        "start_sec": "number",
        "end_sec": "number",
        "top_label": "string",
        "top_probability": "number"
      }
    ],
    "ux_guidance": {
      "headline": "string",
      "body": "string",
      "retry_recommended": "boolean"
    }
  }
}
