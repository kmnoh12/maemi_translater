    "audio_duration_sec": "number",
    "analysis_window_sec": 3.0,
    "hop_sec": 1.5,
    "device_model": "string",
    "sample_rate_hz": 16000
  },
  "output": {
    "presence_result": {
      "label": "cicada_present | no_cicada | unclear",
      "confidence": "number"
    },
    "species_result": {
